pipeline {
    agent any

    parameters {
        choice(
            name: 'APPLICATION',
            choices: [
                'frontend',
                'employee',
                'attendance',
                'salary',
                'notification'
            ],
            description: 'Application to deploy'
        )

        string(
            name: 'VERSION',
            defaultValue: '1.0.0',
            description: 'Application version'
        )

        choice(
            name: 'DEPLOYMENT_PHASE',
            choices: [
                'foundation',
                'application'
            ],
            description: 'Terraform deployment phase'
        )

        choice(
            name: 'ACTION',
            choices: [
                'BUILD_VERIFY',
                'FULL_DEPLOY',
                'ROLLBACK',
                'DESTROY'
            ],
            description: 'Deployment action'
        )

        text(
            name: 'ROLLBACK_AMIS',
            defaultValue: '{}',
            description: 'Previous known-good application AMIs as JSON. Required only for ROLLBACK.'
        )
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Validate Parameters') {
            steps {
                script {
                    if (params.ACTION == 'ROLLBACK') {
                        def rollbackAmis = readJSON text: params.ROLLBACK_AMIS

                        def requiredApplications = [
                            'frontend',
                            'employee',
                            'attendance',
                            'salary',
                            'notification'
                        ]

                        requiredApplications.each { application ->
                            if (!rollbackAmis.containsKey(application) ||
                                !rollbackAmis[application].toString().trim()) {
                                error("ROLLBACK_AMIS must contain a valid AMI ID for ${application}.")
                            }
                        }
                    }
                }
            }
        }

        stage('Terraform Init') {
            when {
                expression {
                    params.ACTION != 'BUILD_VERIFY' ||
                    params.ACTION == 'BUILD_VERIFY'
                }
            }

            steps {
                dir('Terraform') {
                    sh 'terraform init'
                }
            }
        }

        stage('Terraform Validate') {
            steps {
                dir('Terraform') {
                    sh 'terraform validate'
                }
            }
        }

        stage('Terraform Plan') {
            when {
                expression {
                    params.ACTION != 'DESTROY'
                }
            }

            steps {
                script {
                    if (params.ACTION == 'ROLLBACK') {
                        dir('Terraform') {
                            def rollbackAmis = readJSON text: params.ROLLBACK_AMIS

                            sh """
                                terraform plan \
                                  -var="deployment_phase=application" \
                                  -var='application_amis=${groovy.json.JsonOutput.toJson(rollbackAmis)}'
                            """
                        }
                    } else {
                        dir('Terraform') {
                            sh '''
                                terraform plan \
                                  -var="deployment_phase=${DEPLOYMENT_PHASE}"
                            '''
                        }
                    }
                }
            }
        }

        stage('Terraform Apply') {
            when {
                expression {
                    params.ACTION == 'FULL_DEPLOY' ||
                    params.ACTION == 'ROLLBACK'
                }
            }

            steps {
                input message: "${params.ACTION} approved. Continue with Terraform deployment?"

                script {
                    if (params.ACTION == 'ROLLBACK') {
                        dir('Terraform') {
                            def rollbackAmis = readJSON text: params.ROLLBACK_AMIS

                            sh """
                                terraform apply \
                                  -auto-approve \
                                  -var="deployment_phase=application" \
                                  -var='application_amis=${groovy.json.JsonOutput.toJson(rollbackAmis)}'
                            """
                        }
                    } else {
                        dir('Terraform') {
                            sh '''
                                terraform apply \
                                  -auto-approve \
                                  -var="deployment_phase=${DEPLOYMENT_PHASE}"
                            '''
                        }
                    }
                }
            }
        }

        stage('Get Terraform Outputs') {
            when {
                expression {
                    params.ACTION == 'FULL_DEPLOY' &&
                    params.DEPLOYMENT_PHASE == 'application'
                }
            }

            steps {
                dir('Terraform') {
                    script {
                        env.ANSIBLE_SSM_BUCKET_NAME = sh(
                            script: 'terraform output -raw ansible_ssm_bucket_name',
                            returnStdout: true
                        ).trim()
                    }
                }

                echo "Ansible SSM bucket: ${env.ANSIBLE_SSM_BUCKET_NAME}"
            }
        }

        stage('Packer') {
            when {
                expression {
                    params.ACTION == 'FULL_DEPLOY' &&
                    params.DEPLOYMENT_PHASE == 'application'
                }
            }

            steps {
                dir('Packer/applications') {
                    sh '''
                        packer init .
                        packer fmt -check .
                    '''
                }
            }
        }

        stage('Ansible') {
            when {
                expression {
                    params.ACTION == 'FULL_DEPLOY' &&
                    params.DEPLOYMENT_PHASE == 'application'
                }
            }

            steps {
                dir('Ansible') {
                    sh '''
                        ansible-playbook \
                          -i inventory/aws_ec2.yml \
                          playbooks/databases.yml \
                          -e "ansible_aws_ssm_bucket_name=${ANSIBLE_SSM_BUCKET_NAME}"
                    '''
                }
            }
        }

        stage('Rollback Validation') {
            when {
                expression {
                    params.ACTION == 'ROLLBACK'
                }
            }

            steps {
                echo "Rollback completed using the supplied known-good application AMIs."
                echo "Application AMIs: ${params.ROLLBACK_AMIS}"
            }
        }

        stage('Destroy') {
            when {
                expression {
                    params.ACTION == 'DESTROY'
                }
            }

            steps {
                input message: 'Approve Terraform destroy?'

                dir('Terraform') {
                    sh '''
                        terraform destroy \
                          -auto-approve \
                          -var="deployment_phase=${DEPLOYMENT_PHASE}"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "OTMS deployment action ${params.ACTION} completed successfully."
        }

        failure {
            echo "OTMS deployment action ${params.ACTION} failed."
        }
    }
}
