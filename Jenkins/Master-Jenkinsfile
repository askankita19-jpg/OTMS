pipeline {
    agent any

    parameters {
        choice(
            name: 'APPLICATION',
            choices: [
                'frontend',
                'employee',
                'attendance',
                'salary',
                'notification'
            ],
            description: 'Application to deploy'
        )

        string(
            name: 'VERSION',
            defaultValue: '1.0.0',
            description: 'Application version'
        )

        choice(
            name: 'DEPLOYMENT_PHASE',
            choices: [
                'foundation',
                'application'
            ],
            description: 'Terraform deployment phase'
        )
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Terraform Init') {
            steps {
                dir('Terraform') {
                    sh 'terraform init'
                }
            }
        }

        stage('Terraform Validate') {
            steps {
                dir('Terraform') {
                    sh 'terraform validate'
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                dir('Terraform') {
                    sh '''
                        terraform plan \
                          -var="deployment_phase=${DEPLOYMENT_PHASE}"
                    '''
                }
            }
        }

        stage('Terraform Apply') {
            steps {
                input message: 'Approve Terraform deployment?'

                dir('Terraform') {
                    sh '''
                        terraform apply \
                          -auto-approve \
                          -var="deployment_phase=${DEPLOYMENT_PHASE}"
                    '''
                }
            }
        }

        stage('Get Terraform Outputs') {
            when {
                expression {
                    params.DEPLOYMENT_PHASE == 'application'
                }
            }

            steps {
                dir('Terraform') {
                    script {
                        env.ANSIBLE_SSM_BUCKET_NAME = sh(
                            script: 'terraform output -raw ansible_ssm_bucket_name',
                            returnStdout: true
                        ).trim()
                    }
                }

                echo "Ansible SSM bucket: ${env.ANSIBLE_SSM_BUCKET_NAME}"
            }
        }

        stage('Packer') {
            when {
                expression {
                    params.DEPLOYMENT_PHASE == 'application'
                }
            }

            steps {
                dir('Packer/applications') {
                    sh '''
                        packer init .
                        packer fmt -check .
                    '''
                }
            }
        }

        stage('Ansible') {
            when {
                expression {
                    params.DEPLOYMENT_PHASE == 'application'
                }
            }

            steps {
                dir('Ansible') {
                    sh '''
                        ansible-playbook \
                          -i inventory/aws_ec2.yml \
                          playbooks/databases.yml \
                          -e "ansible_aws_ssm_bucket_name=${ANSIBLE_SSM_BUCKET_NAME}"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "OTMS deployment completed successfully."
        }

        failure {
            echo "OTMS deployment failed."
        }
    }
}
